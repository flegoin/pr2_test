// ============================================================
//  ФИЗИЧЕСКАЯ (даталогическая) МОДЕЛЬ — PostgreSQL
//  Предметная область: «Спектакли в театре»
//  Реальные типы данных, ключи, ограничения, индексы.
//  Соответствует скрипту theater.sql и БД theater.
//  Формат: DBML (dbdiagram.io)
// ============================================================

Project theater_physical {
  database_type: 'PostgreSQL'
  Note: 'Физическая модель БД театральных спектаклей'
}

// ---------- 1. genre ----------
Table genre {
  genre_id integer     [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY']
  name     varchar(60) [not null, unique]

  Note: 'Справочник жанров'
}

// ---------- 2. author ----------
Table author {
  author_id  integer      [pk, increment]
  full_name  varchar(120) [not null]
  country    varchar(60)
  birth_year integer      [note: 'CHECK (birth_year BETWEEN 1000 AND 2100)']

  indexes {
    full_name
  }

  Note: 'Авторы (драматурги)'
}

// ---------- 3. performance ----------
Table performance {
  performance_id integer      [pk, increment]
  title          varchar(120) [not null]
  genre_id       integer      [not null, note: 'FK → genre']
  author_id      integer      [not null, note: 'FK → author']
  premiere_date  date         [not null]
  duration_min   integer      [not null, note: 'CHECK (duration_min BETWEEN 30 AND 400)']
  age_limit      integer      [not null, note: 'CHECK (age_limit IN (0,6,12,16,18))']

  indexes {
    genre_id
    author_id
  }

  Note: 'Спектакли (центральная таблица)'
}

// ---------- 4. actor ----------
Table actor {
  actor_id         integer      [pk, increment]
  full_name        varchar(120) [not null]
  birth_date       date         [not null]
  experience_years integer      [not null, note: 'CHECK (experience_years BETWEEN 0 AND 90)']

  Note: 'Актёры театральной труппы'
}

// ---------- 5. role ----------
Table role {
  role_id        integer      [pk, increment]
  role_name      varchar(100) [not null]
  performance_id integer      [not null, note: 'FK → performance']
  actor_id       integer      [not null, note: 'FK → actor']
  is_main        boolean      [not null, default: false]

  indexes {
    performance_id
    actor_id
  }

  Note: 'Роли: связь M:N между performance и actor'
}

// ---------- Внешние ключи ----------
Ref: performance.genre_id  > genre.genre_id
Ref: performance.author_id > author.author_id
Ref: role.performance_id   > performance.performance_id [delete: cascade]
Ref: role.actor_id         > actor.actor_id             [delete: cascade]

// ------------------------------------------------------------
//  Примечание:
//  Индексы по FK (performance.genre_id, performance.author_id,
//  role.performance_id, role.actor_id) добавлены в модель, так
//  как PostgreSQL НЕ создаёт их автоматически. В theater.sql
//  их можно добавить так:
//    CREATE INDEX idx_performance_genre  ON performance(genre_id);
//    CREATE INDEX idx_performance_author ON performance(author_id);
//    CREATE INDEX idx_role_performance   ON role(performance_id);
//    CREATE INDEX idx_role_actor         ON role(actor_id);
// ------------------------------------------------------------
