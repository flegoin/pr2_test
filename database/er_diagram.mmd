%% ============================================================
%% ER-диаграмма БД "Покупка билетов в театр" (упрощённая, 9 таблиц)
%% Исходник Mermaid. Рендер, например: mermaid-cli (mmdc -i er_diagram.mmd -o er_diagram.png)
%% Виды связей: 1:M, M:M (через связующие таблицы), 1:1
%% ============================================================
erDiagram

    жанры {
        integer id PK
        varchar название U
    }

    спектакли {
        integer id PK
        varchar название
        text описание
        integer длительность_минут
        smallint возрастное_ограничение
    }

    спектакли_жанры {
        integer спектакль_id PK, FK
        integer жанр_id PK, FK
    }

    актёры {
        integer id PK
        varchar фамилия
        varchar имя
        varchar отчество
        varchar звание
    }

    актёры_спектакли {
        integer актёр_id PK, FK
        integer спектакль_id PK, FK
        varchar роль
    }

    залы {
        integer id PK
        varchar название
        integer количество_мест
        smallint этаж
    }

    места {
        integer id PK
        integer зал_id FK
        smallint ряд
        smallint номер
        varchar категория
    }

    показы {
        integer id PK
        integer спектакль_id FK
        integer зал_id FK
        timestamp дата_время
        numeric базовая_цена
    }

    паспорта_залов {
        integer id PK
        integer зал_id FK, U
        numeric площадь
        numeric высота_сцены
        smallint год_постройки
    }

    %% Многие-ко-многим (через связующие таблицы)
    спектакли ||--o{ спектакли_жанры : "жанры"
    жанры      ||--o{ спектакли_жанры : "спектакли"
    актёры     ||--o{ актёры_спектакли : "роли"
    спектакли  ||--o{ актёры_спектакли : "труппа"

    %% Один-ко-многим
    залы       ||--o{ места : "места"
    спектакли  ||--o{ показы : "показы"
    залы       ||--o{ показы : "проводятся в"

    %% Один-к-одному
    залы       ||--|| паспорта_залов : "паспорт"
